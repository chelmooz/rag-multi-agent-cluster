    {
      "id": "firewall-rules",
      "type": "text",
      "x": 70,
      "y": 805,
      "width": 610,
      "height": 120,
      "text": "10.10.0.0/24 ↔ 10.10.0.0/24  TCP 6333    Qdrant VectorDB\n10.10.0.0/24 ↔ 10.10.0.0/24  TCP 11434   Ollama API (M2, M3)\n10.10.0.0/24 ↔ 10.10.0.0/24  TCP 2049    NFS Relay + Vault Wiki\n10.10.0.2 → 10.10.0.1      TCP 2049    Mount NFS M1→M2\n192.168.10.0/24 → 10.10.0.1  TCP 80/443  Client → API Gateway (nginx LXC 102)\n10.10.0.0/24 → 192.168.1.0/24 TCP 80/443  Sortie modèles/updates (via pfSense NAT)\n172.16.0.0/24 → any          SSH/HTTPS   Admin Proxmox/IPMI (isolé)",
      "fontSize": 11,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
