# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer .env (voir .gitignore).

# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer .env (voir .gitignore).

# --- API du cluster (LXC 102 : API Gateway) ---
CLUSTER_API_URL=http://CHANGE_ME:8000

# --- Obsidian Vault path (pattern Karpathy) ---
# Chemin absolu du vault partagé sur le LXC Master (bind mount ou NFS)
WIKI_VAULT_PATH=/data/wiki

# --- Ollama sur le nœud BC250 (baremetal, backend Vulkan — voir README) ---
BC250_OLLAMA_URL=http://CHANGE_ME:11434
BC250_OLLAMA_MODEL=nomic-embed-text-v2-moe

# --- Ollama / vLLM sur le nœud GPU Worker (Machine 2, RTX 4000) ---
GPU_WORKER_URL=http://CHANGE_ME:11434
GPU_RERANKER_MODEL=bge-reranker-v2-m3

# --- Ollama sur le Master (Machine 1, RX 580) ---
MASTER_OLLAMA_URL=http://CHANGE_ME:11434
MASTER_OLLAMA_MODEL=qwen2.5:3b

# --- Vector store (Qdrant) ---
QDRANT_URL=http://CHANGE_ME:6333
QDRANT_COLLECTION=rag-wiki

# --- PostgreSQL (conversations, feedback, mémoire long-terme) ---
POSTGRES_HOST=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_DB=rag_cluster
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis (cache, queue orchestrateur) ---
REDIS_URL=redis://CHANGE_ME:6379/0

# --- Modèles (génération et agents) ---
MODEL_GENERATOR=qwen2.5:14b
MODEL_JUDGE=qwen2.5:7b
MODEL_ADVOCATE=mistral:7b
MODEL_EVALUATOR=qwen2.5:3b
