# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer .env (voir .gitignore).
# Noms de variables alignés sur src/core/settings.py (validation_alias).

# ============================================================
# Environnement d'exécution
# ============================================================
ENVIRONMENT=development
# ENVIRONMENT=production   # exige POSTGRES_PASSWORD != CHANGE_ME

# ============================================================
# API du cluster (LXC 100, exposée via pfSense VM 104)
# ============================================================
CLUSTER_API_URL=http://localhost:8000
API_VERSION=v1
LOG_LEVEL=INFO
# LOG_FORMAT=json          # json (prod) ou console (dev local)
# CORRELATION_ID_HEADER=X-Correlation-ID

# ============================================================
# Obsidian Vault path (pattern Karpathy)
# ============================================================
# Chemins absolus du vault partagé sur le LXC Master (bind mount ou NFS)
WIKI_VAULT_PATH=/data/wiki
RAW_DATA_PATH=/data/raw
INDEX_DATA_PATH=/data/index

# ============================================================
# Ollama endpoints par machine
# ============================================================
# Machine 1 - Master (CPU Xeon + RX 580 fallback léger)
OLLAMA_M1_URL=http://10.10.0.1:11434

# Machine 2 - GPU Worker (RTX 4000 CUDA)
OLLAMA_M2_URL=http://10.10.0.2:11434

# Machine 3 - BC250 Baremetal (Vulkan only)
OLLAMA_M3_URL=http://10.10.0.3:11434

# ============================================================
# Modèles par rôle — digest SHA256 OBLIGATOIRE pour reproductibilité
# Format: *_MODEL=nom@... et *_MODEL_DIGEST=sha256:...
# Ex: EMBEDDING_MODEL=nomic-embed-text-v2-moe
#     EMBEDDING_MODEL_DIGEST=sha256:abc123...
# Voir backlog.md pour la liste complète validée 30/07/2026
# ============================================================
# Embedding principal (CPU Machine 1, backup: m2)
EMBEDDING_MODEL=nomic-embed-text-v2-moe
# EMBEDDING_MODEL_DIGEST=sha256:CHANGE_ME
EMBEDDING_HOST=m1

# Generator principal (BC250 Vulkan)
GENERATOR_MODEL=hf.co/Qwen/Qwen3-14B-GGUF:Q4_K_M
# GENERATOR_MODEL_DIGEST=sha256:CHANGE_ME
GENERATOR_ALT_MODEL=qwen3.5-35b-a3b
# GENERATOR_ALT_MODEL_DIGEST=sha256:CHANGE_ME

# Reranker (RTX 4000)
RERANKER_MODEL=bge-reranker-v2-m3
# RERANKER_MODEL_DIGEST=sha256:CHANGE_ME

# Judge (RTX 4000)
JUDGE_MODEL=hf.co/bartowski/DeepSeek-R1-Distill-Llama-8B-GGUF:Q4_K_M
# JUDGE_MODEL_DIGEST=sha256:CHANGE_ME

# Avocat du diable (RTX 4000)
ADVOCATE_MODEL=hf.co/bartowski/Ministral-8B-Instruct-2410-GGUF:Q4_K_M
# ADVOCATE_MODEL_DIGEST=sha256:CHANGE_ME

# Évaluateur (CPU Machine 1)
EVALUATOR_MODEL=qwen3.5:3b
# EVALUATOR_MODEL_DIGEST=sha256:CHANGE_ME

# Text-to-SQL / Code (BC250)
TEXT2SQL_MODEL=qwen3-coder-30b-a3b
# TEXT2SQL_MODEL_DIGEST=sha256:CHANGE_ME

# Vision (BC250 - Phase 5.2)
VISION_MODEL=llava-next:13b
# VISION_MODEL_DIGEST=sha256:CHANGE_ME

# Fast-check lexical (BC250)
FASTCHECK_MODEL=granite-4.0-h-tiny
# FASTCHECK_MODEL_DIGEST=sha256:CHANGE_ME

# ============================================================
# Paramètres pipeline RAG
# ============================================================
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K_RETRIEVAL=20
TOP_K_RERANK=8
SIMILARITY_THRESHOLD=0.7
# Boucle d'évaluation multi-agents (Judge → Advocate → Evaluator) — OFF par défaut
# (aucun LLM pullé en pré-déploiement, 4 appels LLM/requête, cf. décision D12)
EVALUATION_ENABLED=false

# ============================================================
# BC-250 Baremetal (Machine 3 — Vulkan ONLY)
# ============================================================
# BC-250 présent dans le cluster (false = fallback M2)
BC250_ENABLED=true
# Nombre de Compute Units actifs (24=stock, 40=unlock duggasco patch)
BC250_CU_COUNT=40
# CPU core unlock volatil (6c/12t → 8c/16t via SMU msg 0x98, refaire cold boot)
BC250_CPU_CORES_UNLOCKED=false
# VRAM GDDR6 unifiée en GiB (cpu+gpu même pool)
BC250_VRAM_GIB=16
# TDP max watts (cpu+gpu combiné)
BC250_TDP_WATTS=235
# Version minimum Mesa/RADV (Debian Experimental obligatoire)
BC250_VULKAN_MESA_VERSION=25.1.3
# Version noyau cible (pin apt-mark hold, éviter 6.15/6.17)
BC250_KERNEL_VERSION=6.18.18
# Triplet GRUB obligatoire — ne JAMAIS utiliser amd_iommu=on
BC250_GRUB_CMDLINE="amdgpu.gttsize=14750 ttm.pages_limit=3959290 ttm.page_pool_size=3959290"
# TTM pages limit / pool (doit correspondre au triplet ci-dessus)
BC250_TTM_PAGES_LIMIT=3959290
BC250_TTM_PAGE_POOL_SIZE=3959290
# Governor safe-points pour usage soutenu (freq MHz / voltage mV)
BC250_GOV_FREQ_MHZ=1500
BC250_GOV_VOLTAGE_MV=900
BC250_GOV_CONFIG_PATH=/etc/cyan-skillfish-governor-smu/config.toml
# Chemin relatif (depuis racine projet) vers scripts BC-250 setup
BC250_SETUP_DIR=infrastructure/bc250

# ============================================================
# Vector Store (Qdrant — LXC 101)
# ============================================================
QDRANT_URL=http://10.10.0.101:6333
QDRANT_COLLECTION=rag-wiki
# QDRANT_API_KEY=          # optionnel en LAN de confiance

# ============================================================
# PostgreSQL (conversations, feedback, mémoire long-terme)
# ============================================================
POSTGRES_HOST=10.10.0.101
POSTGRES_PORT=5432
POSTGRES_DB=rag_cluster
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# ============================================================
# Redis (cache, queue orchestrateur)
# ============================================================
REDIS_URL=redis://10.10.0.101:6379/0

# ============================================================
# NFS Relay (évaluation séquentielle Juge → Avocat)
# ============================================================
# Fichier JSON partagé M1↔M2 via NFS /data/shared
NFS_RELAY_PATH=/data/shared/evaluation-relay.json
RELAY_TTL_SECONDS=300
JUDGE_TIMEOUT_SECONDS=120

# ============================================================
# OKF (Open Knowledge Format) v0.2
# ============================================================
OKF_STALE_AFTER_DAYS=180
OKF_TRUST_TIERS=["unverified", "machine-confirmed", "human-reviewed"]

# ============================================================
# mTLS (Phase 0.13 - BLOQUANT PROD)
# ============================================================
# Certificats générés via pfSense CA
# MTLS_ENABLED=false
# MTLS_CA_PATH=/etc/ssl/certs/pfsense-ca.crt
# MTLS_CERT_PATH=/etc/ssl/certs/client.crt
# MTLS_KEY_PATH=/etc/ssl/private/client.key

# ============================================================
# Secrets Management (Phase 7)
# ============================================================
# SOPS_AGE_KEY_FILE=/path/to/age.key
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=CHANGE_ME
