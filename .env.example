# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer .env (voir .gitignore).

# --- API du cluster (LXC 102 : API Gateway) ---
CLUSTER_API_URL=http://CHANGE_ME:8000

# --- Ollama sur le nœud BC250 (baremetal, backend Vulkan — voir README) ---
BC250_OLLAMA_HOST=0.0.0.0:11434
BC250_OLLAMA_URL=http://CHANGE_ME:11434
# Ces 3 réglages vont dans systemd override.conf du service ollama, pas ici
# (rappel de config, pas des variables lues par cette app) :
#   OLLAMA_VULKAN=1
#   OLLAMA_KV_CACHE_TYPE=q4_0
#   OLLAMA_CONTEXT_LENGTH=65536

# --- Ollama / vLLM sur le nœud GPU Worker ---
GPU_WORKER_URL=http://CHANGE_ME:11434

# --- Vector store ---
CHROMADB_URL=http://CHANGE_ME:8001

# --- PostgreSQL ---
POSTGRES_HOST=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_DB=rag_cluster
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_URL=redis://CHANGE_ME:6379/0

# --- Modèles ---
MODEL_SMALL=qwen2.5:7b
MODEL_MEDIUM=qwen2.5:14b
MODEL_LARGE=llama3.1:8b
